<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

<t t-name="c2p_property_lease.Tenant360">
    <div class="o_c2p_tenant360">

        <div t-if="state.loading" class="o_c2p_t360_state">Loading the dossier…</div>
        <div t-elif="state.error" class="o_c2p_t360_state o_c2p_t360_error">
            <t t-esc="state.error"/>
        </div>

        <t t-else="">
            <t t-set="d" t-value="state.data"/>

            <!-- Who -->
            <div class="o_c2p_t360_head">
                <img class="o_c2p_t360_avatar" t-att-src="d.avatar" alt=""/>
                <div class="o_c2p_t360_identity">
                    <h1><t t-esc="d.name"/></h1>
                    <div class="o_c2p_t360_sub">
                        <span t-if="d.is_company">Company</span>
                        <span t-else="">Individual</span>
                        <span t-if="d.email"> · <t t-esc="d.email"/></span>
                        <span t-if="d.phone"> · <t t-esc="d.phone"/></span>
                        <span t-if="d.city"> · <t t-esc="d.city"/></span>
                    </div>
                    <div class="o_c2p_t360_tags">
                        <span t-foreach="d.tags" t-as="tag" t-key="tag.id" class="o_c2p_t360_tag">
                            <t t-esc="tag.name"/>
                        </span>
                    </div>
                </div>
                <div class="o_c2p_t360_tenure">
                    <div class="o_c2p_t360_tenure_value"><t t-esc="years(d.tenure.days)"/></div>
                    <div class="o_c2p_t360_tenure_label">
                        a tenant ·
                        <t t-esc="d.tenure.lease_count"/> tenanc<t t-esc="d.tenure.lease_count == 1 ? 'y' : 'ies'"/>
                        <t t-if="d.tenure.renewal_count">, <t t-esc="d.tenure.renewal_count"/> renewed</t>
                    </div>
                </div>
            </div>

            <!-- What should worry you, stacked rather than one replacing another -->
            <div t-if="flags.length" class="o_c2p_t360_flags">
                <div t-foreach="flags" t-as="flag" t-key="flag_index"
                     t-attf-class="o_c2p_t360_flag o_c2p_t360_flag_{{flag.tone}}">
                    <t t-esc="flag.text"/>
                </div>
            </div>

            <!-- Current tenancy -->
            <div class="o_c2p_t360_grid">
                <div class="o_c2p_t360_card o_c2p_t360_wide">
                    <div class="o_c2p_t360_card_title">Current tenancy</div>
                    <div t-if="!d.current" class="o_c2p_t360_empty">
                        No running tenancy for this tenant.
                    </div>
                    <t t-else="">
                        <div class="o_c2p_t360_lease" t-on-click="() => this.openRecord('c2p.lease', d.current.id)">
                            <div class="o_c2p_t360_lease_main">
                                <span class="o_c2p_t360_lease_name"><t t-esc="d.current.name"/></span>
                                <span class="o_c2p_t360_badge"><t t-esc="d.current.state_label"/></span>
                            </div>
                            <div class="o_c2p_t360_sub">
                                <t t-esc="d.current.unit"/>
                                <t t-if="d.current.building"> · <t t-esc="d.current.building"/></t>
                                <t t-if="d.current.landlord"> · landlord <t t-esc="d.current.landlord"/></t>
                            </div>
                        </div>
                        <div class="o_c2p_t360_rows">
                            <div class="o_c2p_t360_row">
                                <span>Term</span>
                                <span><t t-esc="d.current.date_start"/> → <t t-esc="d.current.date_end"/></span>
                            </div>
                            <div class="o_c2p_t360_row">
                                <span>Expires</span>
                                <span><t t-esc="countdown(d.current.days_to_expiry)"/></span>
                            </div>
                            <div class="o_c2p_t360_row">
                                <span>Annual rent</span>
                                <span><t t-esc="amount(d.current.annual_rent)"/></span>
                            </div>
                            <div class="o_c2p_t360_row">
                                <span>Instalment</span>
                                <span>
                                    <t t-esc="amount(d.current.instalment_amount)"/>
                                    × <t t-esc="d.current.cheque_count"/>
                                </span>
                            </div>
                            <div class="o_c2p_t360_row" t-if="d.current.ejari_no">
                                <span>Ejari</span>
                                <span><t t-esc="d.current.ejari_no"/></span>
                            </div>
                            <div class="o_c2p_t360_row" t-if="!d.current.cheques_complete">
                                <span class="o_c2p_t360_warn">Cheques short by</span>
                                <span class="o_c2p_t360_warn"><t t-esc="amount(d.current.cheque_shortfall)"/></span>
                            </div>
                        </div>
                    </t>
                </div>

                <!-- Standing -->
                <div class="o_c2p_t360_card">
                    <div class="o_c2p_t360_card_title">Standing</div>
                    <div class="o_c2p_t360_rows">
                        <div class="o_c2p_t360_row">
                            <span>Contracted rent, running</span>
                            <span><t t-esc="amount(d.standing.contracted_rent)"/></span>
                        </div>
                        <div class="o_c2p_t360_row">
                            <span>Deposit held</span>
                            <span><t t-esc="amount(d.standing.deposit_held)"/></span>
                        </div>
                        <div class="o_c2p_t360_row">
                            <span>Commission</span>
                            <span><t t-esc="amount(d.standing.commission)"/></span>
                        </div>
                        <div class="o_c2p_t360_row o_c2p_t360_row_total">
                            <span>Contracted over all tenancies</span>
                            <span><t t-esc="amount(d.standing.lifetime_contracted)"/></span>
                        </div>
                    </div>
                    <div class="o_c2p_t360_note">
                        Contracted, not collected. What arrived is the cheque register.
                    </div>
                </div>

                <!-- Cheque performance: the BR-098 half that exists today -->
                <div class="o_c2p_t360_card o_c2p_t360_wide">
                    <div class="o_c2p_t360_card_title">
                        Cheque performance
                        <button class="o_c2p_t360_link" t-on-click="openInstruments">open register</button>
                    </div>
                    <div class="o_c2p_t360_kpis">
                        <div class="o_c2p_t360_kpi">
                            <div class="o_c2p_t360_kpi_value"><t t-esc="d.cheques.in_custody"/></div>
                            <div class="o_c2p_t360_kpi_label">in our hands</div>
                        </div>
                        <div class="o_c2p_t360_kpi">
                            <div class="o_c2p_t360_kpi_value"><t t-esc="amount(d.cheques.cover)"/></div>
                            <div class="o_c2p_t360_kpi_label">rent covered</div>
                        </div>
                        <div class="o_c2p_t360_kpi" t-if="d.cheques.shortfall">
                            <div class="o_c2p_t360_kpi_value o_c2p_t360_warn">
                                <t t-esc="amount(d.cheques.shortfall)"/>
                            </div>
                            <div class="o_c2p_t360_kpi_label">uncovered</div>
                        </div>
                        <div class="o_c2p_t360_kpi o_c2p_t360_clickable" t-on-click="openEverBounced">
                            <div t-attf-class="o_c2p_t360_kpi_value {{d.cheques.ever_bounced ? 'o_c2p_t360_danger' : ''}}">
                                <t t-esc="percent(d.cheques.bounce_rate)"/>
                            </div>
                            <div class="o_c2p_t360_kpi_label">
                                bounce rate ·
                                <t t-esc="d.cheques.ever_bounced"/> ever bounced
                            </div>
                        </div>
                    </div>
                    <div class="o_c2p_t360_buckets">
                        <t t-foreach="d.cheques.buckets" t-as="bucket" t-key="bucket.state">
                            <div t-if="bucket.count" class="o_c2p_t360_bucket o_c2p_t360_clickable"
                                 t-on-click="() => this.openBucket(bucket)">
                                <span class="o_c2p_t360_bucket_count"><t t-esc="bucket.count"/></span>
                                <span class="o_c2p_t360_bucket_label"><t t-esc="bucket.label"/></span>
                                <span class="o_c2p_t360_bucket_amount"><t t-esc="amount(bucket.amount)"/></span>
                            </div>
                        </t>
                    </div>
                    <div t-if="!hasInstruments" class="o_c2p_t360_empty">
                        No instruments registered against this tenant's tenancies.
                    </div>
                </div>

                <!-- What falls due next -->
                <div class="o_c2p_t360_card">
                    <div class="o_c2p_t360_card_title">Next due</div>
                    <div t-if="!d.upcoming.length" class="o_c2p_t360_empty">Nothing scheduled.</div>
                    <div t-foreach="d.upcoming" t-as="item" t-key="item_index"
                         class="o_c2p_t360_due o_c2p_t360_clickable"
                         t-on-click="() => this.openRecord(item.res_model, item.res_id)">
                        <div class="o_c2p_t360_due_when">
                            <t t-esc="item.date"/>
                            <span class="o_c2p_t360_sub"><t t-esc="countdown(item.days_away)"/></span>
                        </div>
                        <div class="o_c2p_t360_due_what">
                            <t t-if="item.kind == 'expiry'">Tenancy ends — </t>
                            <t t-esc="item.label"/>
                            <span t-if="item.detail" class="o_c2p_t360_sub"> · <t t-esc="item.detail"/></span>
                        </div>
                        <div class="o_c2p_t360_due_amount"><t t-esc="amount(item.amount)"/></div>
                    </div>
                </div>

                <!-- Cheque exceptions: the pattern no single lease shows -->
                <div class="o_c2p_t360_card o_c2p_t360_wide" t-if="d.exceptions.length">
                    <div class="o_c2p_t360_card_title">Cheque exceptions</div>
                    <div class="o_c2p_t360_note">
                        Times this tenant was let in without their full cheque set. One is an
                        exception; a run of them is a policy.
                    </div>
                    <table class="o_c2p_t360_table">
                        <thead>
                            <tr>
                                <th>Tenancy</th><th>Status</th><th>Short by</th>
                                <th>Deadline</th><th>Approved by</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="d.exceptions" t-as="ex" t-key="ex.id"
                                class="o_c2p_t360_clickable"
                                t-on-click="() => this.openRecord('c2p.lease.cheque.exception', ex.id)">
                                <td><t t-esc="ex.lease"/></td>
                                <td>
                                    <span t-attf-class="o_c2p_t360_badge {{ex.state == 'breached' ? 'o_c2p_t360_badge_danger' : ''}}">
                                        <t t-esc="ex.state_label"/>
                                    </span>
                                </td>
                                <td>
                                    <t t-esc="ex.missing_cheque_count"/> ·
                                    <t t-esc="amount(ex.missing_amount)"/>
                                </td>
                                <td t-attf-class="{{ex.is_overdue ? 'o_c2p_t360_danger' : ''}}">
                                    <t t-esc="ex.deadline"/>
                                </td>
                                <td><t t-esc="ex.approved_by"/></td>
                            </tr>
                        </tbody>
                    </table>
                </div>

                <!-- Tenancy history -->
                <div class="o_c2p_t360_card o_c2p_t360_wide">
                    <div class="o_c2p_t360_card_title">
                        Tenancy history
                        <button class="o_c2p_t360_link" t-on-click="openLeases">open all</button>
                    </div>
                    <table class="o_c2p_t360_table">
                        <thead>
                            <tr>
                                <th>Tenancy</th><th>Unit</th><th>Term</th>
                                <th>Annual rent</th><th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="d.history" t-as="lease" t-key="lease.id"
                                t-attf-class="o_c2p_t360_clickable {{lease.is_closed ? 'o_c2p_t360_muted_row' : ''}}"
                                t-on-click="() => this.openRecord('c2p.lease', lease.id)">
                                <td><t t-esc="lease.name"/></td>
                                <td>
                                    <t t-esc="lease.unit"/>
                                    <span t-if="lease.building" class="o_c2p_t360_sub"> · <t t-esc="lease.building"/></span>
                                </td>
                                <td><t t-esc="lease.date_start"/> → <t t-esc="lease.date_end"/></td>
                                <td><t t-esc="amount(lease.annual_rent)"/></td>
                                <td>
                                    <span t-attf-class="o_c2p_t360_badge {{lease.is_live ? 'o_c2p_t360_badge_live' : ''}}">
                                        <t t-esc="lease.state_label"/>
                                    </span>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </t>
    </div>
</t>

</templates>
