<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- The dossier is reached from the tenant, which is where somebody
         already is when the question "who is this?" comes up. BR-008 keeps
         tenants out of Odoo entirely, so this is a staff screen only. -->
    <record id="view_partner_form_tenant_360" model="ir.ui.view">
        <field name="name">res.partner.form.tenant.360</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="groups_id" eval="[(4, ref('c2p_property_lease.group_property_user'))]"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button name="action_tenant_360" type="object"
                        class="oe_stat_button" icon="fa-id-card-o">
                    <div class="o_stat_info">
                        <span class="o_stat_text">Tenant</span>
                        <span class="o_stat_text">360</span>
                    </div>
                </button>
            </div>
        </field>
    </record>

    <record id="action_tenant_360_list" model="ir.actions.act_window">
        <field name="name">Tenants</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('customer_rank', '&gt;', 0)]</field>
        <field name="context">{'res_partner_search_mode': 'customer'}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No tenants yet</p>
            <p>
                Open a tenant and use <b>Tenant 360</b> for the whole tenancy and
                cheque history in one screen.
            </p>
        </field>
    </record>
</odoo>
