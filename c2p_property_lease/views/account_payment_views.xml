<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pdc_list" model="ir.ui.view">
        <field name="name">account.payment.pdc.list</field>
        <field name="model">account.payment</field>
        <field name="arch" type="xml">
            <list string="Cheque Register" decoration-danger="pdc_state == 'bounced'"
                  decoration-success="pdc_state == 'cleared'">
                <field name="cheque_no"/>
                <field name="partner_id" string="Tenant"/>
                <field name="drawer_partner_id" string="Signed By" optional="hide"/>
                <field name="is_third_party" string="Third Party" optional="hide"/>
                <field name="payee_partner_id" string="Payable To" optional="show"/>
                <field name="unit_id"/>
                <field name="building_id" optional="show"/>
                <field name="operating_model" optional="hide"/>
                <field name="cheque_bank"/>
                <field name="maturity_date"/>
                <field name="amount" sum="Total"/>
                <field name="is_owner_funds" string="Owner Funds" optional="show"/>
                <field name="pdc_state" widget="badge"/>
                <field name="replacement_payment_id" optional="hide"/>
                <field name="bounce_reason" optional="hide"/>
                <field name="state"/>
                <field name="currency_id" column_invisible="1"/>
                <button name="action_pdc_deposit" type="object" string="Deposit"
                        icon="fa-university" invisible="pdc_state != 'held'"/>
                <button name="action_pdc_clear" type="object" string="Cleared"
                        icon="fa-check" invisible="pdc_state not in ('held','deposited')"/>
                <button name="action_pdc_bounce" type="object" string="Bounced"
                        icon="fa-times" invisible="pdc_state in ('bounced','replaced')"/>
            </list>
        </field>
    </record>

    <record id="view_pdc_search" model="ir.ui.view">
        <field name="name">account.payment.pdc.search</field>
        <field name="model">account.payment</field>
        <field name="arch" type="xml">
            <search>
                <field name="cheque_no"/>
                <field name="partner_id"/>
                <field name="building_id"/>
                <filter name="f_held" string="In Hand" domain="[('pdc_state','=','held')]"/>
                <filter name="f_due" string="Due Now"
                        domain="[('maturity_date','&lt;=',context_today().strftime('%Y-%m-%d')),('pdc_state','=','held')]"/>
                <filter name="f_bounced" string="Bounced" domain="[('pdc_state','=','bounced')]"
                        help="Returned unpaid and not yet made good. A bounce with a replacement
                              linked against it moves to Replaced and drops out of here."/>
                <filter name="f_expected" string="Not Yet Handed Over" domain="[('pdc_state','=','expected')]"
                        help="BR-114: the schedule says a cheque is due and none has been received."/>
                <separator/>
                <!-- BRD §6.1. The whole point of the owner-funds flag is that
                     somebody can pull the two sets apart on screen without
                     working out each building's operating model by hand. -->
                <filter name="f_company_funds" string="Company Funds" domain="[('is_owner_funds','=',False)]"/>
                <filter name="f_owner_funds" string="Owner Funds" domain="[('is_owner_funds','=',True)]"/>
                <separator/>
                <filter name="f_third_party" string="Third-Party Cheques" domain="[('is_third_party','=',True)]"/>
                <group>
                    <filter name="g_building" string="Building" context="{'group_by':'building_id'}"/>
                    <filter name="g_state" string="Cheque Status" context="{'group_by':'pdc_state'}"/>
                    <filter name="g_funds" string="Whose Funds" context="{'group_by':'is_owner_funds'}"/>
                    <filter name="g_payee" string="Payable To" context="{'group_by':'payee_partner_id'}"/>
                    <filter name="g_month" string="Maturity Month" context="{'group_by':'maturity_date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_pdc_register" model="ir.actions.act_window">
        <field name="name">Cheque Register</field>
        <field name="res_model">account.payment</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('cheque_no','!=',False)]</field>
        <field name="context">{'search_default_f_held': 1}</field>
    </record>

    <record id="action_pdc_register_view" model="ir.actions.act_window.view">
        <field name="sequence">1</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_pdc_list"/>
        <field name="act_window_id" ref="action_pdc_register"/>
    </record>
</odoo>
