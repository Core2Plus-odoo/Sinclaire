<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_unit_list" model="ir.ui.view">
        <field name="name">c2p.unit.list</field>
        <field name="model">c2p.unit</field>
        <field name="arch" type="xml">
            <list string="Units">
                <field name="image_128" widget="image" width="48" options="{'size': [48, 48]}"/>
                <field name="name"/>
                <field name="building_id"/>
                <field name="unit_type"/>
                <field name="area_sqft" optional="hide"/>
                <field name="market_rent"/>
                <field name="tenant_id"/>
                <field name="lease_end"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'occupied'"
                       decoration-warning="state == 'notice'"
                       decoration-danger="state == 'vacant'"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_unit_kanban" model="ir.ui.view">
        <field name="name">c2p.unit.kanban</field>
        <field name="model">c2p.unit</field>
        <field name="arch" type="xml">
            <kanban default_group_by="building_id">
                <field name="state"/>
                <templates>
                    <t t-name="card">
                        <field name="image_256" widget="image" class="w-100 mb-2"
                               options="{'zoom': true, 'img_class': 'w-100 rounded'}"/>
                        <div class="d-flex justify-content-between">
                            <strong><field name="name"/></strong>
                            <field name="state" widget="label_selection"
                                   options="{'classes': {'vacant': 'danger', 'occupied': 'success', 'notice': 'warning', 'blocked': 'secondary'}}"/>
                        </div>
                        <div class="text-muted"><field name="unit_type"/></div>
                        <div class="mt-1">
                            <field name="tenant_id"/>
                        </div>
                        <div class="text-muted" invisible="not lease_end">
                            Ends <field name="lease_end"/>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_unit_form" model="ir.ui.view">
        <field name="name">c2p.unit.form</field>
        <field name="model">c2p.unit</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <field name="image_1920" widget="image" class="oe_avatar"
                           options="{'preview_image': 'image_128'}"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="MKH-201"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="building_id"/>
                            <field name="unit_type"/>
                            <field name="floor"/>
                            <field name="area_sqft"/>
                            <field name="dewa_no"/>
                        </group>
                        <group>
                            <field name="state"/>
                            <field name="market_rent"/>
                            <field name="rera_index_low"/>
                            <field name="rera_index_high"/>
                            <field name="current_lease_id" readonly="1"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Lease History" name="history">
                            <field name="lease_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="tenant_id"/>
                                    <field name="date_start"/>
                                    <field name="date_end"/>
                                    <field name="annual_rent"/>
                                    <field name="state" widget="badge"/>
                                    <field name="currency_id" column_invisible="1"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_unit_search" model="ir.ui.view">
        <field name="name">c2p.unit.search</field>
        <field name="model">c2p.unit</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="building_id"/>
                <field name="tenant_id"/>
                <filter name="f_vacant" string="Vacant" domain="[('state','=','vacant')]"/>
                <filter name="f_occupied" string="Occupied" domain="[('state','=','occupied')]"/>
                <filter name="f_notice" string="Under Notice" domain="[('state','=','notice')]"/>
                <group expand="0" string="Group By">
                    <filter name="g_building" string="Building" context="{'group_by':'building_id'}"/>
                    <filter name="g_state" string="Status" context="{'group_by':'state'}"/>
                    <filter name="g_type" string="Type" context="{'group_by':'unit_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_unit" model="ir.actions.act_window">
        <field name="name">Units</field>
        <field name="res_model">c2p.unit</field>
        <field name="view_mode">kanban,list,form</field>
    </record>
</odoo>
