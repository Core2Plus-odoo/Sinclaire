<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_bank_facility_list" model="ir.ui.view">
        <field name="name">c2p.bank.facility.list</field>
        <field name="model">c2p.bank.facility</field>
        <field name="arch" type="xml">
            <list decoration-danger="utilisation_pct &gt;= 90"
                  decoration-warning="utilisation_pct &gt;= 75 and utilisation_pct &lt; 90">
                <field name="name"/>
                <field name="bank_id"/>
                <field name="facility_type"/>
                <field name="limit_amount" sum="Limit"/>
                <field name="utilised_amount" sum="Utilised"/>
                <field name="available_amount" sum="Available"/>
                <field name="utilisation_pct" widget="progressbar"/>
                <field name="review_date"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_bank_facility_form" model="ir.ui.view">
        <field name="name">c2p.bank.facility.form</field>
        <field name="model">c2p.bank.facility</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title"><h1><field name="name" placeholder="Facility name"/></h1></div>
                    <group>
                        <group>
                            <field name="bank_id"/>
                            <field name="facility_type"/>
                            <field name="journal_id"/>
                            <field name="review_date"/>
                        </group>
                        <group>
                            <field name="limit_amount"/>
                            <field name="utilised_amount"/>
                            <field name="available_amount"/>
                            <field name="utilisation_pct" widget="progressbar"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="company_id" invisible="1"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_bank_facility" model="ir.actions.act_window">
        <field name="name">Banking Facilities</field>
        <field name="res_model">c2p.bank.facility</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
