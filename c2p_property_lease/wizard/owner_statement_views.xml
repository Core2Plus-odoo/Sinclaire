<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_owner_statement_form" model="ir.ui.view">
        <field name="name">c2p.owner.statement.form</field>
        <field name="model">c2p.owner.statement</field>
        <field name="arch" type="xml">
            <form string="Landlord Statement">
                <group>
                    <group>
                        <field name="building_id"/>
                        <field name="owner_id"/>
                        <field name="management_fee_pct"/>
                        <field name="fee_invoice_id" readonly="1"/>
                        <field name="currency_id" invisible="1"/>
                    </group>
                    <group>
                        <field name="date_from"/>
                        <field name="date_to"/>
                    </group>
                </group>
                <group string="Preview">
                    <field name="rent_invoiced"/>
                    <field name="expenses"/>
                    <field name="management_fee"/>
                    <field name="net_payable"/>
                </group>
                <footer>
                    <button name="action_print" type="object" string="Generate Statement" class="btn-primary"/>
                    <button name="action_create_fee_invoice" type="object"
                            string="Raise Management Fee Invoice" class="btn-secondary"
                            invisible="fee_invoice_id or not management_fee"
                            confirm="This posts a real invoice to the landlord. Continue?"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_owner_statement" model="ir.actions.act_window">
        <field name="name">Landlord Statement</field>
        <field name="res_model">c2p.owner.statement</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
