<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_landlord_cheque_register_form" model="ir.ui.view">
        <field name="name">c2p.landlord.cheque.register.form</field>
        <field name="model">c2p.landlord.cheque.register</field>
        <field name="arch" type="xml">
            <form string="Issue Landlord Cheques">
                <group>
                    <group>
                        <field name="head_lease_id"/>
                        <field name="journal_id"/>
                    </group>
                    <group>
                        <field name="first_maturity"/>
                        <field name="first_cheque_no" placeholder="e.g. 400121"/>
                        <field name="currency_id" invisible="1"/>
                        <field name="company_id" invisible="1"/>
                    </group>
                </group>
                <field name="line_ids">
                    <list editable="bottom">
                        <field name="maturity_date"/>
                        <field name="cheque_no"/>
                        <field name="amount" sum="Total"/>
                        <field name="currency_id" column_invisible="1"/>
                    </list>
                </field>
                <footer>
                    <button name="action_issue" type="object" string="Issue Cheques"
                            class="btn-primary"
                            confirm="This records cheques issued to the landlord. Continue?"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
