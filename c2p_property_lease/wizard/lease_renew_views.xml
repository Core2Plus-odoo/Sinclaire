<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_lease_renew_form" model="ir.ui.view">
        <field name="name">c2p.lease.renew.form</field>
        <field name="model">c2p.lease.renew</field>
        <field name="arch" type="xml">
            <form string="Renew Lease">
                <group>
                    <group>
                        <field name="lease_id"/>
                        <field name="current_rent"/>
                        <field name="new_rent"/>
                        <field name="increase_pct"/>
                        <field name="currency_id" invisible="1"/>
                    </group>
                    <group>
                        <field name="date_start"/>
                        <field name="date_end"/>
                        <field name="cheque_count"/>
                    </group>
                </group>
                <div class="alert alert-warning" role="alert" invisible="not rera_warning">
                    <field name="rera_warning" readonly="1" nolabel="1"/>
                </div>
                <footer>
                    <button name="action_renew" type="object" string="Create Renewal" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
