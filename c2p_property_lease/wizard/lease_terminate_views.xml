<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_lease_terminate_form" model="ir.ui.view">
        <field name="name">c2p.lease.terminate.form</field>
        <field name="model">c2p.lease.terminate</field>
        <field name="arch" type="xml">
            <form string="Terminate Lease">
                <group>
                    <group>
                        <field name="lease_id"/>
                        <field name="date_termination"/>
                        <field name="currency_id" invisible="1"/>
                    </group>
                    <group>
                        <field name="deposit_held"/>
                        <field name="deduction"/>
                        <field name="deduction_reason"/>
                        <field name="refund_amount"/>
                    </group>
                </group>
                <footer>
                    <button name="action_terminate" type="object" string="Terminate" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
