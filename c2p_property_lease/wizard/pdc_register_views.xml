<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pdc_register_form" model="ir.ui.view">
        <field name="name">c2p.pdc.register.form</field>
        <field name="model">c2p.pdc.register</field>
        <field name="arch" type="xml">
            <form string="Register Post-Dated Cheques">
                <group>
                    <group>
                        <field name="lease_id"/>
                        <field name="journal_id"/>
                        <field name="currency_id" invisible="1"/>
                    </group>
                    <group>
                        <field name="first_maturity"/>
                        <field name="first_cheque_no"/>
                        <field name="bank_name"/>
                    </group>
                </group>
                <field name="line_ids">
                    <list editable="bottom">
                        <field name="cheque_no"/>
                        <field name="bank_name"/>
                        <field name="maturity_date"/>
                        <field name="amount" sum="Total"/>
                        <field name="currency_id" column_invisible="1"/>
                    </list>
                </field>
                <footer>
                    <button name="action_confirm" type="object" string="Register Cheques" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
