<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="seq_lease" model="ir.sequence">
        <field name="name">Tenancy Lease</field>
        <field name="code">c2p.lease</field>
        <field name="prefix">LSE/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="seq_head_lease" model="ir.sequence">
        <field name="name">Head Lease</field>
        <field name="code">c2p.head.lease</field>
        <field name="prefix">HL/%(year)s/</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>

</odoo>
