<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_property" model="ir.module.category">
        <field name="name">Property Management</field>
        <field name="sequence">20</field>
    </record>

    <record id="res_groups_privilege_property" model="res.groups.privilege">
        <field name="name">Property Management</field>
        <field name="sequence">20</field>
        <field name="category_id" ref="module_category_property"/>
    </record>

    <record id="group_property_user" model="res.groups">
        <field name="name">Leasing User</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_property"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Manage units, leases and cheques.</field>
    </record>

    <record id="group_property_manager" model="res.groups">
        <field name="name">Leasing Manager</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_property"/>
        <!-- Billing comes with the manager role, not with the user role.
             Clearing, depositing and bouncing a cheque are writes on
             account.payment, and without an accounting group a manager cannot
             even read the register: the Collections screen installs cleanly
             and is invisible, which is the same defect the comment below
             records.

             Deliberately NOT given to group_property_user. A leasing agent
             does not bank cheques, and money handling is the one thing that
             should not widen by default. When the BRD's twenty roles are
             mapped, a dedicated collections role may take this over. -->
        <field name="implied_ids"
               eval="[(4, ref('group_property_user')), (4, ref('account.group_account_invoice'))]"/>
        <!-- Without a member, nobody sees the Property menu after install - it is
             gated on group_property_user, and no user is in either group by
             default. The module installed and was invisible, administrator
             included. sinclaire_base seeds its own manager group the same way. -->
        <field name="user_ids" eval="[(4, ref('base.user_admin'))]"/>
        <field name="comment">Full access including buildings, head leases, bank facilities and terminations.</field>
    </record>

    <record id="rule_building_company" model="ir.rule">
        <field name="name">Building: multi-company</field>
        <field name="model_id" ref="model_c2p_building"/>
        <field name="domain_force">[('company_id','in',company_ids)]</field>
    </record>

    <record id="rule_unit_company" model="ir.rule">
        <field name="name">Unit: multi-company</field>
        <field name="model_id" ref="model_c2p_unit"/>
        <field name="domain_force">[('company_id','in',company_ids)]</field>
    </record>

    <record id="rule_lease_company" model="ir.rule">
        <field name="name">Lease: multi-company</field>
        <field name="model_id" ref="model_c2p_lease"/>
        <field name="domain_force">[('company_id','in',company_ids)]</field>
    </record>

    <record id="rule_cheque_exception_company" model="ir.rule">
        <field name="name">Cheque exception: multi-company</field>
        <field name="model_id" ref="model_c2p_lease_cheque_exception"/>
        <field name="domain_force">[('company_id','in',company_ids)]</field>
    </record>

    <record id="rule_tenancy_event_company" model="ir.rule">
        <field name="name">Tenancy event: multi-company</field>
        <field name="model_id" ref="model_c2p_tenancy_event"/>
        <field name="domain_force">[('company_id','in',company_ids)]</field>
    </record>
</odoo>
