<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_ceo_dashboard_form" model="ir.ui.view">
        <field name="name">c2p.ceo.dashboard.form</field>
        <field name="model">c2p.ceo.dashboard</field>
        <field name="arch" type="xml">
            <form string="Command Center" create="false">
                <sheet>
                    <div class="oe_title mb-3">
                        <h1>Command Center</h1>
                    </div>

                    <group col="4" class="mb-4">
                        <field name="company_id" options="{'no_create': True}"/>
                        <field name="date_from"/>
                        <field name="date_to"/>
                        <field name="currency_id" invisible="1"/>
                    </group>

                    <!-- Headline: the four numbers worth waking up to -->
                    <div class="row g-3 mb-4">
                        <div class="col-6 col-lg-3">
                            <div class="card h-100 border-0 shadow-sm">
                                <div class="card-body text-center">
                                    <div class="text-muted small text-uppercase">Occupancy</div>
                                    <div class="display-6 fw-bold text-success"
                                         invisible="occupancy_rate &lt; 85">
                                        <field name="occupancy_rate" widget="percentage" nolabel="1"/>
                                    </div>
                                    <div class="display-6 fw-bold text-warning"
                                         invisible="occupancy_rate &gt;= 85 or occupancy_rate &lt; 70">
                                        <field name="occupancy_rate" widget="percentage" nolabel="1"/>
                                    </div>
                                    <div class="display-6 fw-bold text-danger"
                                         invisible="occupancy_rate &gt;= 70">
                                        <field name="occupancy_rate" widget="percentage" nolabel="1"/>
                                    </div>
                                    <div class="small text-muted">
                                        <field name="occupied_count" nolabel="1"/> of
                                        <field name="unit_count" nolabel="1"/> units
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-6 col-lg-3">
                            <div class="card h-100 border-0 shadow-sm">
                                <div class="card-body text-center">
                                    <div class="text-muted small text-uppercase">Contracted Rent</div>
                                    <div class="display-6 fw-bold">
                                        <field name="contracted_rent" nolabel="1"/>
                                    </div>
                                    <div class="small text-muted">
                                        <field name="active_lease_count" nolabel="1"/> active leases
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-6 col-lg-3">
                            <div class="card h-100 border-0 shadow-sm">
                                <div class="card-body text-center">
                                    <div class="text-muted small text-uppercase">Rent at Risk</div>
                                    <div class="display-6 fw-bold text-warning">
                                        <field name="expiring_rent" nolabel="1"/>
                                    </div>
                                    <div class="small text-muted">
                                        <field name="expiring_lease_count" nolabel="1"/> leases,
                                        <field name="lease_at_risk_rate" widget="percentage" nolabel="1"/>
                                        of portfolio
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-6 col-lg-3">
                            <div class="card h-100 border-0 shadow-sm">
                                <div class="card-body text-center">
                                    <div class="text-muted small text-uppercase">Revenue Foregone</div>
                                    <div class="display-6 fw-bold text-danger">
                                        <field name="vacant_market_rent" nolabel="1"/>
                                    </div>
                                    <div class="small text-muted">
                                        <field name="vacant_count" nolabel="1"/> units vacant
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <group>
                        <group string="Portfolio">
                            <field name="building_count"/>
                            <field name="unit_count"/>
                            <field name="occupied_count"/>
                            <field name="vacant_count"/>
                            <field name="avg_rent_per_unit"/>
                            <field name="avg_rent_per_sqft"/>
                        </group>
                        <group string="Renewal Pipeline">
                            <field name="expiring_30"/>
                            <field name="expiring_60"/>
                            <field name="expiring_90"/>
                            <field name="expiring_rent"/>
                            <field name="lease_at_risk_rate" widget="percentage"/>
                        </group>
                    </group>

                    <group>
                        <group string="Cheque Position">
                            <field name="pdc_held_count"/>
                            <field name="pdc_held_amount"/>
                            <field name="pdc_deposited_count"/>
                            <field name="pdc_deposited_amount"/>
                            <field name="pdc_cleared_count"/>
                            <field name="pdc_cleared_amount"/>
                        </group>
                        <group string="Collection Health">
                            <field name="pdc_bounced_count"/>
                            <field name="pdc_bounced_amount"/>
                            <label for="bounce_rate"/>
                            <div>
                                <field name="bounce_rate" widget="percentage" nolabel="1"
                                       class="text-danger fw-bold" invisible="bounce_rate &lt; 5"/>
                                <field name="bounce_rate" widget="percentage" nolabel="1"
                                       invisible="bounce_rate &gt;= 5"/>
                            </div>
                            <field name="overdue_receivable"/>
                        </group>
                    </group>

                    <group string="Income">
                        <group>
                            <field name="rent_invoiced"/>
                        </group>
                        <group>
                            <field name="fee_invoiced"/>
                        </group>
                    </group>

                    <div class="mt-4">
                        <h5 class="text-muted">Analyse</h5>
                        <button name="action_lease_expiry_profile" type="object"
                                string="Expiry Profile" class="btn-primary me-1"/>
                        <button name="action_rent_by_building" type="object"
                                string="Rent by Building" class="btn-primary me-1"/>
                        <button name="action_open_unit_mix" type="object"
                                string="Unit Mix" class="btn-primary me-1"/>
                        <button name="action_open_cheque_register" type="object"
                                string="Cheque Register" class="btn-primary me-1"/>
                    </div>
                    <div class="mt-3">
                        <h5 class="text-muted">Act</h5>
                        <button name="action_open_vacant_units" type="object"
                                string="Vacant Units" class="btn-secondary me-1"/>
                        <button name="action_open_expiring_leases" type="object"
                                string="Expiring Leases" class="btn-secondary me-1"/>
                        <button name="action_open_cheques_in_hand" type="object"
                                string="Cheques in Hand" class="btn-secondary me-1"/>
                        <button name="action_open_bounced_cheques" type="object"
                                string="Bounced Cheques" class="btn-secondary me-1"/>
                        <button name="action_open_active_leases" type="object"
                                string="Active Leases" class="btn-secondary me-1"/>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_ceo_dashboard" model="ir.actions.act_window">
        <field name="name">Command Center</field>
        <field name="res_model">c2p.ceo.dashboard</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
        <field name="view_id" ref="view_ceo_dashboard_form"/>
    </record>

</odoo>
