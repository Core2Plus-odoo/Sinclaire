<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_ceo_dashboard_form" model="ir.ui.view">
        <field name="name">c2p.ceo.dashboard.form</field>
        <field name="model">c2p.ceo.dashboard</field>
        <field name="arch" type="xml">
            <form string="Command Center" create="false">
                <sheet class="o_c2p_dashboard">

                    <div class="d-flex flex-wrap align-items-end justify-content-between mb-2">
                        <div>
                            <h1 class="mb-0">Command Center</h1>
                            <div class="text-muted small">Portfolio, cash and risk at a glance</div>
                        </div>
                        <div class="d-flex gap-3">
                            <span><field name="company_id" options="{'no_create': True}"/></span>
                            <span><field name="date_from"/></span>
                            <span><field name="date_to"/></span>
                            <field name="currency_id" invisible="1"/>
                        </div>
                    </div>

                    <!-- Headline -->
                    <div class="row g-3">
                        <div class="col-12 col-sm-6 col-xl-3">
                            <div class="o_c2p_card o_c2p_accent o_c2p_accent_positive"
                                 invisible="occupancy_rate &lt; 85">
                                <div class="o_c2p_label"><i class="fa fa-building-o"/>Occupancy</div>
                                <div class="o_c2p_value o_c2p_positive">
                                    <field name="occupancy_rate" widget="percentage" nolabel="1"/>
                                </div>
                                <div class="o_c2p_sub">
                                    <field name="occupied_count" nolabel="1"/> of
                                    <field name="unit_count" nolabel="1"/> units let
                                </div>
                                <div class="o_c2p_meter">
                                    <field name="occupancy_rate" widget="progressbar" nolabel="1"/>
                                </div>
                            </div>
                            <div class="o_c2p_card o_c2p_accent o_c2p_accent_warning"
                                 invisible="occupancy_rate &gt;= 85 or occupancy_rate &lt; 70">
                                <div class="o_c2p_label"><i class="fa fa-building-o"/>Occupancy</div>
                                <div class="o_c2p_value o_c2p_warning">
                                    <field name="occupancy_rate" widget="percentage" nolabel="1"/>
                                </div>
                                <div class="o_c2p_sub">
                                    <field name="occupied_count" nolabel="1"/> of
                                    <field name="unit_count" nolabel="1"/> units let
                                </div>
                                <div class="o_c2p_meter">
                                    <field name="occupancy_rate" widget="progressbar" nolabel="1"/>
                                </div>
                            </div>
                            <div class="o_c2p_card o_c2p_accent o_c2p_accent_danger"
                                 invisible="occupancy_rate &gt;= 70">
                                <div class="o_c2p_label"><i class="fa fa-building-o"/>Occupancy</div>
                                <div class="o_c2p_value o_c2p_danger">
                                    <field name="occupancy_rate" widget="percentage" nolabel="1"/>
                                </div>
                                <div class="o_c2p_sub">
                                    <field name="occupied_count" nolabel="1"/> of
                                    <field name="unit_count" nolabel="1"/> units let
                                </div>
                                <div class="o_c2p_meter">
                                    <field name="occupancy_rate" widget="progressbar" nolabel="1"/>
                                </div>
                            </div>
                        </div>

                        <div class="col-12 col-sm-6 col-xl-3">
                            <div class="o_c2p_card o_c2p_accent">
                                <div class="o_c2p_label"><i class="fa fa-line-chart"/>Contracted Rent</div>
                                <div class="o_c2p_value">
                                    <field name="contracted_rent" nolabel="1"/>
                                </div>
                                <div class="o_c2p_sub">
                                    <field name="active_lease_count" nolabel="1"/> active leases ·
                                    <field name="avg_rent_per_unit" nolabel="1"/> average
                                </div>
                            </div>
                        </div>

                        <div class="col-12 col-sm-6 col-xl-3">
                            <div class="o_c2p_card o_c2p_accent o_c2p_accent_warning">
                                <div class="o_c2p_label"><i class="fa fa-hourglass-half"/>Rent at Risk</div>
                                <div class="o_c2p_value o_c2p_warning">
                                    <field name="expiring_rent" nolabel="1"/>
                                </div>
                                <div class="o_c2p_sub">
                                    <field name="expiring_lease_count" nolabel="1"/> leases expiring in 90 days
                                </div>
                                <div class="o_c2p_meter">
                                    <field name="lease_at_risk_rate" widget="progressbar" nolabel="1"/>
                                </div>
                            </div>
                        </div>

                        <div class="col-12 col-sm-6 col-xl-3">
                            <div class="o_c2p_card o_c2p_accent o_c2p_accent_danger">
                                <div class="o_c2p_label"><i class="fa fa-exclamation-triangle"/>Revenue Foregone</div>
                                <div class="o_c2p_value o_c2p_danger">
                                    <field name="vacant_market_rent" nolabel="1"/>
                                </div>
                                <div class="o_c2p_sub">
                                    <field name="vacant_count" nolabel="1"/> units vacant at market rent
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Detail -->
                    <div class="o_c2p_section_title">Portfolio and pipeline</div>
                    <div class="row g-3">
                        <div class="col-12 col-lg-4">
                            <div class="o_c2p_card">
                                <div class="o_c2p_label"><i class="fa fa-th-large"/>Portfolio</div>
                                <div class="o_c2p_row"><span>Buildings</span>
                                    <span class="o_c2p_row_value"><field name="building_count" nolabel="1"/></span></div>
                                <div class="o_c2p_row"><span>Units</span>
                                    <span class="o_c2p_row_value"><field name="unit_count" nolabel="1"/></span></div>
                                <div class="o_c2p_row"><span>Occupied</span>
                                    <span class="o_c2p_row_value"><field name="occupied_count" nolabel="1"/></span></div>
                                <div class="o_c2p_row"><span>Vacant</span>
                                    <span class="o_c2p_row_value"><field name="vacant_count" nolabel="1"/></span></div>
                                <div class="o_c2p_row"><span>Rent per sq ft</span>
                                    <span class="o_c2p_row_value"><field name="avg_rent_per_sqft" nolabel="1"/></span></div>
                            </div>
                        </div>

                        <div class="col-12 col-lg-4">
                            <div class="o_c2p_card">
                                <div class="o_c2p_label"><i class="fa fa-calendar-o"/>Renewal Pipeline</div>
                                <div class="o_c2p_row"><span>Within 30 days</span>
                                    <span class="o_c2p_row_value"><field name="expiring_30" nolabel="1"/></span></div>
                                <div class="o_c2p_row"><span>31 – 60 days</span>
                                    <span class="o_c2p_row_value"><field name="expiring_60" nolabel="1"/></span></div>
                                <div class="o_c2p_row"><span>61 – 90 days</span>
                                    <span class="o_c2p_row_value"><field name="expiring_90" nolabel="1"/></span></div>
                                <div class="o_c2p_row"><span>Rent at risk</span>
                                    <span class="o_c2p_row_value"><field name="expiring_rent" nolabel="1"/></span></div>
                                <div class="o_c2p_row"><span>Portfolio at risk</span>
                                    <span class="o_c2p_row_value"><field name="lease_at_risk_rate" widget="percentage" nolabel="1"/></span></div>
                            </div>
                        </div>

                        <div class="col-12 col-lg-4">
                            <div class="o_c2p_card">
                                <div class="o_c2p_label"><i class="fa fa-money"/>Cheque Position</div>
                                <div class="o_c2p_row"><span>In hand</span>
                                    <span class="o_c2p_row_value"><field name="pdc_held_amount" nolabel="1"/></span></div>
                                <div class="o_c2p_row"><span>Deposited</span>
                                    <span class="o_c2p_row_value"><field name="pdc_deposited_amount" nolabel="1"/></span></div>
                                <div class="o_c2p_row"><span>Cleared</span>
                                    <span class="o_c2p_row_value o_c2p_positive"><field name="pdc_cleared_amount" nolabel="1"/></span></div>
                                <div class="o_c2p_row"><span>Bounced</span>
                                    <span class="o_c2p_row_value o_c2p_danger"><field name="pdc_bounced_amount" nolabel="1"/></span></div>
                                <div class="o_c2p_row"><span>Bounce rate</span>
                                    <span class="o_c2p_row_value o_c2p_danger" invisible="bounce_rate &lt; 5">
                                        <field name="bounce_rate" widget="percentage" nolabel="1"/></span>
                                    <span class="o_c2p_row_value" invisible="bounce_rate &gt;= 5">
                                        <field name="bounce_rate" widget="percentage" nolabel="1"/></span></div>
                            </div>
                        </div>
                    </div>

                    <div class="o_c2p_section_title">The deal</div>
                    <div class="row g-3">
                        <div class="col-12 col-lg-4">
                            <div class="o_c2p_card">
                                <div class="o_c2p_label"><i class="fa fa-handshake-o"/>Underwriting</div>
                                <div class="o_c2p_row"><span>Committed to landlords</span>
                                    <span class="o_c2p_row_value"><field name="head_lease_cost" nolabel="1"/></span></div>
                                <div class="o_c2p_row"><span>Contracted tenant rent</span>
                                    <span class="o_c2p_row_value"><field name="contracted_rent" nolabel="1"/></span></div>
                                <div class="o_c2p_row"><span>Gross margin</span>
                                    <span class="o_c2p_row_value"><field name="gross_margin" nolabel="1"/></span></div>
                                <div class="o_c2p_row"><span>Margin</span>
                                    <span class="o_c2p_row_value"><field name="margin_pct" widget="percentage" nolabel="1"/></span></div>
                                <div class="o_c2p_row"><span>Break-even occupancy</span>
                                    <span class="o_c2p_row_value"><field name="breakeven_occupancy" widget="percentage" nolabel="1"/></span></div>
                                <div class="o_c2p_row"><span>Buildings below cost</span>
                                    <span class="o_c2p_row_value o_c2p_danger" invisible="buildings_below_cost == 0">
                                        <field name="buildings_below_cost" nolabel="1"/></span>
                                    <span class="o_c2p_row_value" invisible="buildings_below_cost &gt; 0">
                                        <field name="buildings_below_cost" nolabel="1"/></span></div>
                            </div>
                        </div>

                        <div class="col-12 col-lg-4">
                            <div class="o_c2p_card">
                                <div class="o_c2p_label"><i class="fa fa-sign-out"/>Landlord Cheques</div>
                                <div class="o_c2p_row"><span>Due in 30 days</span>
                                    <span class="o_c2p_row_value"><field name="landlord_due_30" nolabel="1"/></span></div>
                                <div class="o_c2p_row"><span>Due in 90 days</span>
                                    <span class="o_c2p_row_value"><field name="landlord_due_90" nolabel="1"/></span></div>
                                <div class="o_c2p_row"><span>Issued, not cleared</span>
                                    <span class="o_c2p_row_value"><field name="landlord_outstanding" nolabel="1"/></span></div>
                                <div class="o_c2p_row"><span>Our cheques bounced</span>
                                    <span class="o_c2p_row_value o_c2p_danger" invisible="landlord_bounced_count == 0">
                                        <field name="landlord_bounced_count" nolabel="1"/></span>
                                    <span class="o_c2p_row_value" invisible="landlord_bounced_count &gt; 0">
                                        <field name="landlord_bounced_count" nolabel="1"/></span></div>
                                <div class="o_c2p_row"><span>Rent invoiced to date</span>
                                    <span class="o_c2p_row_value"><field name="rent_invoiced" nolabel="1"/></span></div>
                            </div>
                        </div>

                        <div class="col-12 col-lg-4">
                            <div class="o_c2p_card">
                                <div class="o_c2p_label"><i class="fa fa-university"/>Cash and Facilities</div>
                                <div class="o_c2p_row"><span>Tenant cheques in, 90 days</span>
                                    <span class="o_c2p_row_value"><field name="tenant_inflow_90" nolabel="1"/></span></div>
                                <div class="o_c2p_row"><span>Net 90-day position</span>
                                    <span class="o_c2p_row_value o_c2p_danger" invisible="net_position_90 &gt;= 0">
                                        <field name="net_position_90" nolabel="1"/></span>
                                    <span class="o_c2p_row_value o_c2p_positive" invisible="net_position_90 &lt; 0">
                                        <field name="net_position_90" nolabel="1"/></span></div>
                                <div class="o_c2p_row"><span>Facility limit</span>
                                    <span class="o_c2p_row_value"><field name="facility_limit" nolabel="1"/></span></div>
                                <div class="o_c2p_row"><span>Headroom</span>
                                    <span class="o_c2p_row_value"><field name="facility_available" nolabel="1"/></span></div>
                                <div class="o_c2p_row"><span>Unfunded gap</span>
                                    <span class="o_c2p_row_value o_c2p_danger" invisible="funding_gap == 0">
                                        <field name="funding_gap" nolabel="1"/></span>
                                    <span class="o_c2p_row_value" invisible="funding_gap &gt; 0">
                                        <field name="funding_gap" nolabel="1"/></span></div>
                                <div class="o_c2p_meter">
                                    <field name="facility_utilisation" widget="progressbar" nolabel="1"/>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="o_c2p_section_title">Analyse</div>
                    <div class="o_c2p_actions">
                        <button name="action_lease_expiry_profile" type="object"
                                string="Expiry Profile" icon="fa-bar-chart" class="btn-primary"/>
                        <button name="action_rent_by_building" type="object"
                                string="Rent by Building" icon="fa-table" class="btn-primary"/>
                        <button name="action_open_unit_mix" type="object"
                                string="Unit Mix" icon="fa-pie-chart" class="btn-primary"/>
                        <button name="action_open_cheque_register" type="object"
                                string="Cheque Register" icon="fa-list" class="btn-primary"/>
                    </div>

                    <div class="o_c2p_section_title">Act</div>
                    <div class="o_c2p_actions">
                        <button name="action_open_vacant_units" type="object"
                                string="Vacant Units" class="btn-secondary"/>
                        <button name="action_open_expiring_leases" type="object"
                                string="Expiring Leases" class="btn-secondary"/>
                        <button name="action_open_cheques_in_hand" type="object"
                                string="Cheques in Hand" class="btn-secondary"/>
                        <button name="action_open_bounced_cheques" type="object"
                                string="Bounced Cheques" class="btn-secondary"/>
                        <button name="action_open_active_leases" type="object"
                                string="Active Leases" class="btn-secondary"/>
                    </div>

                </sheet>
            </form>
        </field>
    </record>

    <record id="action_ceo_dashboard" model="ir.actions.act_window">
        <field name="name">Command Center</field>
        <field name="res_model">c2p.ceo.dashboard</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
        <field name="view_id" ref="view_ceo_dashboard_form"/>
    </record>

</odoo>
