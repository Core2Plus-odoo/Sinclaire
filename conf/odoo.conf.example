; Sample Odoo server configuration for local Sinclaire development.
; Copy to odoo.conf (git-ignored) and adjust to your machine.
[options]
addons_path = /path/to/odoo/addons,/path/to/odoo/enterprise,./addons
data_dir = ./.odoo-data

db_host = localhost
db_port = 5432
db_user = odoo
db_password = False
db_name = sinclaire

http_port = 8069
dev = reload,qweb,xml
log_level = info
list_db = True
