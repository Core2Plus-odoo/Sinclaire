<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="module_category_sinclaire" model="ir.module.category">
            <field name="name">Sinclaire</field>
            <field name="description">Access levels for Sinclaire customisations.</field>
            <field name="sequence">20</field>
        </record>

        <record id="group_sinclaire_user" model="res.groups">
            <field name="name">User</field>
            <field name="category_id" ref="module_category_sinclaire"/>
            <field name="comment">Day-to-day access to Sinclaire customisations.</field>
        </record>

        <record id="group_sinclaire_manager" model="res.groups">
            <field name="name">Manager</field>
            <field name="category_id" ref="module_category_sinclaire"/>
            <field name="implied_ids" eval="[(4, ref('group_sinclaire_user'))]"/>
            <field name="comment">Full configuration access to Sinclaire customisations.</field>
        </record>

        <record id="base.user_admin" model="res.users">
            <field name="groups_id" eval="[(4, ref('group_sinclaire_manager'))]"/>
        </record>

    </data>
</odoo>
